# Export variables in your shell or use uvicorn --env-file after installing python-dotenv.
# All Quran data and selected Hadith summaries work without an LLM or API key.
NOOR_ENABLE_EXTERNAL=true
# Local Ollama explanations are enabled; set false for retrieval-only mode.
NOOR_OLLAMA_ENABLED=true
NOOR_OLLAMA_URL=http://127.0.0.1:11434
NOOR_OLLAMA_MODEL=qwen2.5:1.5b
